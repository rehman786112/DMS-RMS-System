QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;

    border: 1px solid #e2e8f0;

    gridline-color: #edf1f5;

    font-family: "Segoe UI";
    font-size: 14px;
    color: #1e293b;
    font-weight: 500;
    selection-background-color: #e8f0fe;
    selection-color: #1d4ed8;

    outline: none;
}

/* =========================================================
   TABLE HEADER
   ========================================================= */

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background-color: #093573;
    color: #e8f0fe;
    font-weight: bold;
    font-family: "Segoe UI";
    font-size: 15px;
    padding: 10px;
    border: 1px solid #e8f0fe;
    text-align: center;
    /* Add these properties for text wrapping */
    white-space: normal;
    height: auto; /* Allows height to adjust based on content */
}
QHeaderView::section:hover {
    background-color: #093573;
}
QMessageBox QLabel{
    color: black;
}
/* =========================================================
   TABLE CELLS
   ========================================================= */

QTableView::item {
    padding: 2px 4px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    text-align: center;
}

/* Hover */

QTableView::item:hover {
    background-color: #f8fafc;
}

/* Selected row */

QTableView::item:selected {
    background-color: #1d4ed8;
    color: #e8f0fe;
}

/* Selected + focus */

QTableView::item:selected:active {
    background-color: #1d4ed8;
    color: #e8f0fe;
}

/* =========================================================
   SCROLLBAR
   ========================================================= */

QTableView QScrollBar:vertical {
    background: transparent;

    width: 8px;

    margin: 2px;
}

QTableView QScrollBar::handle:vertical {
    background-color: #cbd5e1;

    min-height: 40px;

    border-radius: 4px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 0px;
}

QTableView QScrollBar::add-page:vertical,
QTableView QScrollBar::sub-page:vertical {
    background: transparent;
}


/* Horizontal Scrollbar */

QTableView QScrollBar:horizontal {
    background: transparent;

    height: 8px;

    margin: 2px;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #cbd5e1;

    min-width: 40px;

    border-radius: 4px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 0px;
}

QTableView QScrollBar::add-page:horizontal,
QTableView QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* =========================================================
   CORNER
   ========================================================= */

QTableView QAbstractScrollArea::corner {
    background-color: #f1f5f9;
}
QCheckBox {
    spacing: 8px;
    color: #1f2937;
    font-size: 14px;
    font-weight: 500;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #cbd5e1;
    border-radius: 5px;
    background-color: white;
}

QCheckBox::indicator:hover {
    border-color: #2563eb;
    background-color: #eff6ff;
}

QCheckBox::indicator:checked {
    border-color: #2563eb;
    background-color: #2563eb;
}

QCheckBox::indicator:checked:hover {
    border-color: #1d4ed8;
    background-color: #1d4ed8;
}

QCheckBox::indicator:disabled {
    border-color: #e5e7eb;
    background-color: #f3f4f6;
}

QCheckBox::indicator:checked:disabled {
    border-color: #94a3b8;
    background-color: #94a3b8;
}
#add_btn{
    background-color: #093573;
    color: #e8f0fe;
    border-radius: 1px;
    font-size: 19px;
}
#input_widget{
    border: 2px solid gray;
}
#tablabels{
    color: black;
}
/* =========================================================
   MODERN DARK SIDEBAR
   ========================================================= */

QListWidget {
    background: #151922;
    border: none;
    outline: none;

    padding: 12px 8px;

    color: #AEB7C4;

    font-family: "Segoe UI";
    font-size: 18px;
    font-weight: 500;
}

/* ---------------------------------------------------------
   Items
   --------------------------------------------------------- */

QListWidget::item {
    background: transparent;

    color: #AEB7C4;

    padding: 13px 16px;
    margin: 3px 4px;

    border: none;
    border-radius: 8px;

    min-height: 22px;
}

/* ---------------------------------------------------------
   Hover
   --------------------------------------------------------- */

QListWidget::item:hover {
    background: #202632;
    color: #F1F5F9;
}

/* ---------------------------------------------------------
   Selected
   --------------------------------------------------------- */

QListWidget::item:selected {
    background: #1E3A5F;

    color: #60A5FA;

    font-weight: 600;

    border: none;
    border-left:5px solid #1604db;
    border-radius: 0;
}

/* ---------------------------------------------------------
   Selected + Hover
   --------------------------------------------------------- */

QListWidget::item:selected:hover {
    background: #23466F;
    color: #93C5FD;
}

/* ---------------------------------------------------------
   Focus
   --------------------------------------------------------- */

QListWidget:focus {
    outline: none;
}

/* ---------------------------------------------------------
   Disabled
   --------------------------------------------------------- */

QListWidget::item:disabled {
    color: #4B5563;
    background: transparent;
}
